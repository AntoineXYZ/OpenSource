{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Linux: Legacy spacecraft viewer (already built)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux-debug/bin/AuSceneClient",
      "args": ["-legacy-spacecraft"],
      "cwd": "${workspaceFolder}/build/linux-debug/bin",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "presentation": {
        "group": "Legacy spacecraft",
        "order": 2
      },
      "windows": {
        "presentation": {
          "hidden": true
        }
      }
    },
    {
      "name": "Windows: Legacy spacecraft viewer (already built)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-debug/bin/AuSceneClient.exe",
      "args": ["-legacy-spacecraft"],
      "cwd": "${workspaceFolder}/build/windows-debug/bin",
      "MIMode": "gdb",
      "pipeTransport": {
        "pipeProgram": "C:/Windows/System32/cmd.exe",
        "pipeArgs": ["/c"],
        "debuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "presentation": {
        "group": "Legacy spacecraft",
        "order": 1
      },
      "linux": {
        "program": "//wsl.localhost/${env:WSL_DISTRO_NAME}${workspaceFolder}/build/windows-debug/bin/AuSceneClient.exe",
        "cwd": "//wsl.localhost/${env:WSL_DISTRO_NAME}${workspaceFolder}/build/windows-debug/bin",
        "pipeTransport": {
          "pipeProgram": "/bin/sh",
          "pipeArgs": ["-c"],
          "debuggerPath": "/mnt/c/msys64/ucrt64/bin/gdb.exe",
          "pipeCwd": "${workspaceFolder}"
        }
      }
    },
    {
      "name": "Linux Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux-debug/bin/AuSceneClient",
      "args": ["-alocalhost", "-log"],
      "cwd": "${workspaceFolder}/build/linux-debug/bin",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Docker: build Linux client (Debug)",
      "presentation": {
        "group": "Linux",
        "order": 1
      },
      "windows": {
        "presentation": {
          "hidden": true
        }
      }
    },
    {
      "name": "Linux Server: Attach scene-worker-1",
      "type": "cppdbg",
      "request": "attach",
      "program": "/opt/openshores/bin/AuSceneServer",
      "processId": "1",
      "MIMode": "gdb",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "compose",
          "--env-file", "build/server/local/compose.env",
          "-f", "deploy/server/compose.yaml",
          "-f", "build/server/local/workers.compose.json",
          "exec", "-T", "--privileged", "--user", "root", "-i", "scene-worker-1"
        ],
        "debuggerPath": "/usr/bin/gdb",
        "quoteArgs": false,
        "pipeCwd": "${workspaceFolder}"
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "setupCommands": [
        {
          "description": "Enable GDB pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "presentation": {
        "group": "Linux Servers",
        "order": 1
      },
      "windows": {
        "presentation": {
          "hidden": true
        }
      }
    },
    {
      "name": "Linux RelWithDebInfo",
      "type": "cppdbg",
