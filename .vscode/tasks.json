{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: build Linux client (Debug)",
      "type": "process",
      "command": "make",
      "args": ["CONFIG=debug", "linux-client"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Docker: build Linux client (RelWithDebInfo)",
      "type": "process",
      "command": "make",
      "args": ["CONFIG=relwithdebinfo", "linux-client"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: local servers up (Debug)",
      "type": "process",
      "command": "make",
      "args": ["SERVER_CONFIG=debug", "server-up"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd", "${workspaceFolder}",
          "--exec", "make", "SERVER_CONFIG=debug", "server-up"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: local servers down",
      "type": "process",
      "command": "make",
      "args": ["server-down"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd", "${workspaceFolder}",
          "--exec", "make", "server-down"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: build Windows client (Debug)",
      "type": "process",
      "command": "make",
      "args": ["CONFIG=debug", "win-client"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd", "${workspaceFolder}",
          "--exec", "make", "CONFIG=debug", "win-client"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: build Windows client (RelWithDebInfo)",
      "type": "process",
      "command": "make",
      "args": ["CONFIG=relwithdebinfo", "win-client"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd", "${workspaceFolder}",
          "--exec", "make", "CONFIG=relwithdebinfo", "win-client"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: build Windows client (Release)",
      "type": "process",
      "command": "make",
      "args": ["CONFIG=release", "win-client"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd", "${workspaceFolder}",
          "--exec", "make", "CONFIG=release", "win-client"
        ]
      },
      "problemMatcher": []
    }
  ]
}
