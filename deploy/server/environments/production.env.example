# Copy to deploy/server/environments/production.env, keep it out of Git, and replace every
# CHANGE_ME value before rendering or starting the production stack.
SERVER_BUILD_CONFIG=release
SCENE_WORKERS=1
ATOM_MANAGERS=1

BIND_ADDRESS=0.0.0.0
PUBLIC_HOST=game.example.com
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
LOGIN_WORKER_PORT=16767
MAIL_WORKER_PORT=16768
SCENE_MANAGER_PORT=16769
SCENE_WORKER_PORT_BASE=16800

COMPOSE_PROJECT_NAME=openshores-production
POSTGRES_VOLUME=openshores-production-postgres
POSTGRES_PASSWORD=CHANGE_ME
AU_DB_OWNER_PASSWORD=CHANGE_ME
AU_DB_PASSWORD=CHANGE_ME
SERVER_LOGIN_PASSWORD=CHANGE_ME
INTERNAL_AUTH_TOKEN=CHANGE_ME

CREATE_LOCAL_PLAYER=false
LOCAL_PLAYER_NAME=
LOCAL_PLAYER_PASSWORD=
